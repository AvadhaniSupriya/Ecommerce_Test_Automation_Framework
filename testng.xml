<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Automation Framework" verbose="1" parallel="methods" thread-count="2">
  <test name="UI Test Automation">
    <classes>
       <class name="com.ui.tests.LoginTest"/>
       <parameter name="browser" value="${browser}"></parameter>
       <parameter name="isLambda" value="${isLambda}"></parameter>
       <parameter name="isHeadless" value="${isHeadless}"></parameter>
    </classes>
  </test>
</suite>

  